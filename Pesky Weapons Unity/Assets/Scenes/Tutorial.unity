      value: 2076
      objectReference: {fileID: 0}
    - target: {fileID: 4847792993207919483, guid: b542e34f43602244da5b82f945262781, type: 3}
      propertyPath: text
      value: 'THE DUMMY HOPS EVERY FEW SECONDS. AS THE ARCH MAGE, LOOK AT IT WHILE
        IT IS IN THE AIR: LEFT CLICK NUDGES IT AWAY FROM YOU, RIGHT CLICK PULLS IT
        TOWARD YOU. ONLY WHILE THEY ARE IN THE AIR, CLOSE BY AND IN SIGHT. ON A FRIEND
        IT LOOKS LIKE A JUMP THAT WENT WRONG - ONLY A SOUL SEES THE WISP IT LEAVES.
        THE ABILITY BAR AT THE BOTTOM OF YOUR SCREEN SHOWS WHEN A NUDGE OR A CURSE
        IS READY AGAIN.'
      objectReference: {fileID: 0}
    - target: {fileID: 7111973095020096852, guid: b542e34f43602244da5b82f945262781, type: 3}
      propertyPath: m_Name
      value: Sign_Nudge
      objectReference: {fileID: 0}
