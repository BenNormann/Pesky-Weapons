<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="run-root" class="run-root" picking-mode="Ignore">
        <ui:Style src="project://database/Assets/UI/Run.uss" />

        <ui:VisualElement name="blind-overlay" class="blind-overlay" picking-mode="Ignore" />

        <ui:Label name="timer" class="timer" text="5:00" picking-mode="Ignore" />

        <ui:Label name="note" class="note" text="" picking-mode="Ignore" />

        <ui:VisualElement name="curse-status" class="curse-status" picking-mode="Ignore">
            <ui:Label name="curse-name" class="curse-name" text="" picking-mode="Ignore" />
            <ui:Label name="curse-time" class="curse-time" text="" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="ability-bar" class="ability-bar" picking-mode="Ignore" />

        <ui:VisualElement name="role-reveal" class="role-reveal" picking-mode="Ignore">
            <ui:Label name="role-title" class="role-title" text="" picking-mode="Ignore" />
            <ui:Label name="role-sub" class="role-sub" text="" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="result-banner" class="result-banner" picking-mode="Ignore">
            <ui:Label name="result-title" class="result-title" text="" picking-mode="Ignore" />
            <ui:Label name="result-sub" class="result-sub" text="" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:Label name="ghost-status" class="ghost-status" text="" picking-mode="Ignore" />

        <ui:VisualElement name="vote-root" class="vote-root">
            <ui:VisualElement name="vote-panel" class="vote-panel">
                <ui:Label name="vote-title" class="vote-title" text="VOTE CALLED BY" />
                <ui:Label name="vote-sub" class="vote-sub" text="everybody is frozen. one vote each, and every vote is public. click a name or SKIP VOTE, then CONFIRM." />
                <ui:Label name="vote-timer" class="vote-timer" text="25" />
                <ui:VisualElement name="vote-grid" class="vote-grid" />
                <ui:VisualElement name="vote-skip-row" class="vote-skip-row">
                    <ui:Button name="vote-skip" text="SKIP VOTE" class="vote-card vote-card--skip" />
                    <ui:VisualElement name="vote-skip-chips" class="vote-chips vote-chips--skip" />
                </ui:VisualElement>
                <ui:Button name="vote-confirm" text="CONFIRM" class="vote-confirm" />
                <ui:Label name="vote-status" class="vote-status" text="" />
                <ui:VisualElement name="vote-result" class="vote-result">
                    <ui:Label name="vote-result-title" class="vote-result-title" text="" />
                    <ui:Label name="vote-result-sub" class="vote-result-sub" text="" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="end-root" class="end-root">
            <ui:VisualElement name="end-panel" class="end-panel">
                <ui:Label name="end-title" class="end-title" text="GAME OVER" picking-mode="Ignore" />
                <ui:Label name="end-reason" class="end-reason" text="" picking-mode="Ignore" />
                <ui:Label name="end-mage" class="end-mage" text="" picking-mode="Ignore" />
                <ui:Button name="end-button" text="BACK TO THE ROOM" class="end-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
