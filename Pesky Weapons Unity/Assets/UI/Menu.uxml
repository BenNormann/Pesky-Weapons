<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="menu-root" class="menu-root">
        <Style src="project://database/Assets/UI/Menu.uss?fileID=7433441132597879392&amp;guid=2f98ed4370004a14a824b8c923835de1&amp;type=3#Menu"/>
        <ui:VisualElement name="title-page" class="page">
            <ui:Label name="game-title" text="PESKY WEAPONS" class="game-title"/>
            <ui:Label name="tagline" text="possessed weapons, one labyrinth, and one of you is not helping" class="tagline"/>
            <ui:VisualElement name="callsign-card" class="card">
                <ui:Label text="Name&#10;" class="field-label"/>
                <ui:TextField name="callsign-field" class="field"/>
            </ui:VisualElement>
            <ui:VisualElement name="play-card" class="card">
                <ui:Button name="host-button" text="HOST" class="button button--primary"/>
                <ui:VisualElement name="join-row" class="row">
                    <ui:TextField name="code-field" class="field"/>
                    <ui:Button name="join-button" text="JOIN" class="button button--side"/>
                </ui:VisualElement>
                <ui:Label name="join-hint" text="" class="hint"/>
                <ui:Button name="tutorial-button" text="TUTORIAL" class="button"/>
            </ui:VisualElement>
            <ui:Label name="title-status" text="" class="status"/>
            <ui:Button name="quit-button" text="QUIT" class="button button--quiet"/>
        </ui:VisualElement>
        <ui:VisualElement name="room-page" class="page">
            <ui:Label name="room-title" text="ROOM" class="page-title"/>
            <ui:VisualElement name="code-card" class="card">
                <ui:Label text="ROOM CODE" class="field-label"/>
                <ui:VisualElement name="code-row" class="row">
                    <ui:Label name="room-code" text="" class="room-code"/>
                    <ui:Button name="copy-button" text="COPY" class="button button--small"/>
                </ui:VisualElement>
                <ui:Label name="room-addresses" text="" class="caption"/>
            </ui:VisualElement>
            <ui:VisualElement name="crew-card" class="card">
                <ui:Label name="crew-header" text="CREW   0 / 8" class="field-label"/>
                <ui:VisualElement name="crew-rows" class="crew-rows"/>
            </ui:VisualElement>
            <ui:Label name="labyrinth-line" text="" class="caption"/>
            <ui:Label name="room-status" text="" class="status"/>
            <ui:VisualElement name="room-buttons" class="row">
                <ui:Button name="start-button" text="START" class="button button--primary grow"/>
                <ui:Button name="leave-button" text="LEAVE" class="button button--side grow"/>
            </ui:VisualElement>
            <ui:Label name="wait-label" text="waiting for the host to start the run" class="caption"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
