<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="exit-compass-root" class="exit-compass-root" picking-mode="Ignore">
        <ui:VisualElement name="exit-compass" class="exit-compass" picking-mode="Ignore">
            <ui:Label text="FINAL EXIT" class="exit-compass-title" picking-mode="Ignore" />
            <ui:VisualElement name="exit-compass-dial" class="exit-compass-dial" picking-mode="Ignore" />
            <ui:Label name="exit-compass-progress" class="exit-compass-progress" text="" picking-mode="Ignore" />
            <ui:Label name="exit-compass-status" class="exit-compass-status" text="" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
