/* The settings screen (Escape in a level). Built on Menu.uss, which Settings.uxml also loads: the same cards,
   buttons, captions and the one amber accent. Only what the menu has no class for is here. */

.settings-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 9, 12, 0.78);
    padding: 24px 16px;
}

.settings-panel {
    width: 100%;
    max-width: 640px;
    max-height: 100%;
    background-color: rgb(14, 16, 20);
    border-width: 1px;
    border-color: rgb(38, 42, 52);
    border-radius: 8px;
    padding: 22px 24px 12px 24px;
}

.settings-title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(238, 238, 234);
    -unity-text-align: middle-center;
    margin: 0 0 2px 0;
}

.settings-sub {
    font-size: 13px;
    color: rgb(110, 116, 128);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 0 16px 0;
}

/* ---- one setting per row: name, control, value ---- */

.setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
}

.setting-name {
    width: 150px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(214, 218, 226);
    margin: 0;
}

.setting-value {
    width: 64px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(226, 186, 74);
    -unity-text-align: middle-right;
    margin: 0;
}

.setting-hint {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: rgb(110, 116, 128);
    white-space: normal;
    margin: 0 12px 0 0;
}

.setting-slider {
    flex-grow: 1;
    margin: 0 12px 0 0;
}

.setting-slider .unity-base-field__label {
    display: none;
}

.setting-slider .unity-base-slider__tracker {
    background-color: rgb(36, 40, 50);
    border-color: rgb(58, 64, 78);
}

.setting-slider .unity-base-slider__dragger {
    background-color: rgb(226, 186, 74);
    border-color: rgb(226, 186, 74);
}

/* ---- the ON / OFF switch ---- */

Button.switch {
    min-width: 76px;
    min-height: 34px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(150, 156, 168);
    background-color: rgb(36, 40, 50);
    border-width: 1px;
    border-color: rgb(58, 64, 78);
    border-radius: 4px;
    margin: 0;
}

Button.switch:hover {
    background-color: rgb(48, 54, 66);
    border-color: rgb(80, 88, 104);
}

Button.switch.switch--on {
    color: rgb(18, 18, 20);
    background-color: rgb(226, 186, 74);
    border-color: rgb(226, 186, 74);
}

Button.switch.switch--on:hover {
    background-color: rgb(240, 204, 108);
    border-color: rgb(240, 204, 108);
}

Button.button--danger {
    color: rgb(18, 18, 20);
    background-color: rgb(226, 104, 84);
    border-color: rgb(226, 104, 84);
}

Button.button--danger:hover {
    background-color: rgb(240, 128, 108);
    border-color: rgb(240, 128, 108);
}

.card-button {
    margin: 10px 0 0 0;
}

/* ---- the keybinds page ---- */

.keys-scroll {
    max-height: 460px;
    flex-shrink: 1;
    margin: 0 0 4px 0;
}

.keys-row {
    flex-direction: row;
    align-items: center;
    min-height: 38px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(32, 36, 44);
}

.keys-name {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(228, 228, 224);
    margin: 0;
}

Button.keys-key {
    min-width: 130px;
    min-height: 30px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(238, 238, 234);
    background-color: rgb(36, 40, 50);
    border-width: 1px;
    border-color: rgb(58, 64, 78);
    border-radius: 4px;
    margin: 3px 0;
}

Button.keys-key:hover {
    background-color: rgb(48, 54, 66);
    border-color: rgb(80, 88, 104);
}

Button.keys-key.keys-key--changed {
    border-color: rgb(226, 186, 74);
}

Button.keys-key.keys-key--waiting {
    color: rgb(18, 18, 20);
    background-color: rgb(226, 186, 74);
    border-color: rgb(226, 186, 74);
}

/* ---- the host's exit confirm ---- */

.confirm-text {
    font-size: 16px;
    color: rgb(238, 238, 234);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 8px 0 18px 0;
}
