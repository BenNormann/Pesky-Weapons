/* The settings screen (Escape in a level). Built on Menu.uss, which Settings.uxml also loads: the same cards,
   buttons, captions and the one amber accent. Only what the menu has no class for is here. */

.settings-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 9, 12, 0.78);
    padding: 24px 16px;
}

.settings-panel {
    width: 100%;
    max-width: 640px;
    max-height: 100%;
    background-color: rgb(14, 16, 20);
    border-width: 1px;
    border-color: rgb(38, 42, 52);
    border-radius: 8px;
    padding: 22px 24px 12px 24px;
}

.settings-title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(238, 238, 234);
    -unity-text-align: middle-center;
    margin: 0 0 2px 0;
}

.settings-sub {
    font-size: 13px;
    color: rgb(110, 116, 128);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 0 16px 0;
}

/* ---- one setting per row: name, control, value ---- */

.setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
}

.setting-name {
    width: 150px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(214, 218, 226);
    margin: 0;
}

.setting-value {
    width: 64px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(226, 186, 74);
    -unity-text-align: middle-right;
    margin: 0;
}

.setting-slider {
    flex-grow: 1;
    margin: 0 12px 0 0;
}

.setting-slider .unity-base-field__label {
    display: none;
}

.setting-slider .unity-base-slider__tracker {
    background-color: rgb(36, 40, 50);
    border-color: rgb(58, 64, 78);
}

.setting-slider .unity-base-slider__dragger {
    background-color: rgb(226, 186, 74);
    border-color: rgb(226, 186, 74);
}

Button.button--danger {
    color: rgb(18, 18, 20);
    background-color: rgb(226, 104, 84);
    border-color: rgb(226, 104, 84);
}

Button.button--danger:hover {
    background-color: rgb(240, 128, 108);
    border-color: rgb(240, 128, 108);
}

/* A button that closes a card (KEYBINDS): a section gap above it, not a row gap. Button.button (Menu.uss)
   sets every margin, so this needs the same element + class weight to win. */
Button.button.card-button {
    margin: 14px 0 0 0;
}

/* ---- the keybinds page ---- */

.keys-scroll {
    max-height: 460px;
    flex-shrink: 1;
    margin: 0 0 4px 0;
}

/* ---- scrollbars: thin, dark, rounded, no arrow buttons ----
   Every ScrollView under a document that loads this sheet (today only keys-scroll; the menu has none).
   Each selector carries one more class than the default theme's, so it wins. The scroller sits beside the
   viewport (not over it), 10px from the rows; the mouse wheel is the ScrollView's own and still works. */

.unity-scroll-view .unity-scroller--vertical {
    width: 8px;
    min-width: 8px;
    margin: 0 0 0 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroll-view .unity-scroller--horizontal {
    height: 8px;
    min-height: 8px;
    margin: 10px 0 0 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroll-view .unity-scroller > .unity-scroller__low-button,
.unity-scroll-view .unity-scroller > .unity-scroller__high-button {
    display: none;
}

.unity-scroll-view .unity-scroller--vertical > .unity-scroller__slider {
    width: 8px;
    min-width: 8px;
    margin: 0;
    padding: 0;
}

.unity-scroll-view .unity-scroller--horizontal > .unity-scroller__slider {
    height: 8px;
    min-height: 8px;
    margin: 0;
    padding: 0;
}

.unity-scroll-view .unity-scroller .unity-base-slider__tracker {
    background-color: rgb(22, 25, 31);
    border-width: 0;
    border-radius: 4px;
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    left: 0;
    width: 8px;
    margin: 0;
    background-color: rgb(62, 68, 82);
    border-width: 0;
    border-radius: 4px;
}

.unity-scroll-view .unity-scroller--horizontal .unity-base-slider__dragger {
    top: 0;
    height: 8px;
    margin: 0;
    background-color: rgb(62, 68, 82);
    border-width: 0;
    border-radius: 4px;
}

.unity-scroll-view .unity-scroller .unity-base-slider__dragger:hover:enabled {
    background-color: rgb(88, 96, 114);
}

.unity-scroll-view .unity-scroller .unity-base-slider__dragger:active:enabled {
    background-color: rgb(110, 118, 136);
}

.keys-row {
    flex-direction: row;
    align-items: center;
    min-height: 38px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(32, 36, 44);
}

.keys-name {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(228, 228, 224);
    margin: 0;
}

Button.keys-key {
    min-width: 130px;
    min-height: 30px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(238, 238, 234);
    background-color: rgb(36, 40, 50);
    border-width: 1px;
    border-color: rgb(58, 64, 78);
    border-radius: 4px;
    margin: 3px 0;
}

Button.keys-key:hover {
    background-color: rgb(48, 54, 66);
    border-color: rgb(80, 88, 104);
}

Button.keys-key.keys-key--changed {
    border-color: rgb(226, 186, 74);
}

Button.keys-key.keys-key--waiting {
    color: rgb(18, 18, 20);
    background-color: rgb(226, 186, 74);
    border-color: rgb(226, 186, 74);
}

/* ---- the host's exit confirm ---- */

.confirm-text {
    font-size: 16px;
    color: rgb(238, 238, 234);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 8px 0 18px 0;
}

/* The full-screen toggle: top-right corner of the whole screen while settings are up, outside the panel. */
Button.fullscreen-button {
    position: absolute;
    top: 16px;
    right: 16px;
    min-height: 40px;
    font-size: 14px;
    letter-spacing: 2px;
    padding: 0 14px;
    margin: 0;
}
